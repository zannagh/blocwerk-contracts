{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blocwerk.app/contracts/layouts/panels-bundle.schema.json",
  "title": "PanelsBundleLayout",
  "description": "GET .../bundle of a 'register-panels' job (RunnerPanelsBundle), at most 8 GiB. register-job.json is written last. The instance is the list of the zip's entry names, in order.",
  "type": "array",
  "items": {
    "type": "string",
    "anyOf": [
      {
        "type": "string",
        "const": "register-job.json"
      },
      {
        "pattern": "^photos/[^/\\\\]+\\.(jpg|jpeg|png)$"
      },
      {
        "pattern": "^panels/[0-9a-f]{32}r[0-9]+\\.(jpg|jpeg|png)$"
      }
    ]
  },
  "uniqueItems": true,
  "allOf": [
    {
      "contains": {
        "type": "string",
        "const": "register-job.json"
      }
    },
    {
      "contains": {
        "type": "string",
        "pattern": "^photos/"
      }
    }
  ]
}
