{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blocwerk.app/contracts/jobs/splat/zones.schema.json",
  "title": "SplatZones",
  "description": "Optional zones.json of a 'splat' bundle: the wall zones gsplat trains with (splat-worker zones.spec + toWorldMm, zone_run.write_zones). Present only when the job opted in; a runner applies it only when params.wallZones is true (or its own SPLAT_WALL_ZONES=1). Checked by the server (RunnerZones), at most 1 MiB.",
  "type": "object",
  "required": [
    "facets",
    "boxLo",
    "boxHi",
    "params",
    "toWorldMm"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "1 (not checked by the server)."
    },
    "facets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/zoneFacet"
      }
    },
    "floorMm": {
      "description": "The floor height, mm (not checked by the server)."
    },
    "boxLo": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Lower corner of the wall box, wall world (mm)."
    },
    "boxHi": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "params": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "maxLength": 64
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "description": "Zone parameters (numbers or booleans); 'wallZones': true marks the opt-in."
    },
    "toWorldMm": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "description": "Row-major 4x4: COLMAP frame of the bundle -> wall world, mm."
    }
  },
  "$defs": {
    "zoneFacet": {
      "type": "object",
      "required": [
        "o",
        "u",
        "v",
        "n",
        "ext"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "o": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Origin, mm."
        },
        "u": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "v": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "n": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "Normal."
        },
        "ext": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[aMin, aMax, bMin, bMax] in the facet's (u, v) frame, mm."
        }
      }
    }
  }
}
