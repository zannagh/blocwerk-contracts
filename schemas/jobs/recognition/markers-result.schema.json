{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blocwerk.app/contracts/jobs/recognition/markers-result.schema.json",
  "title": "MarkersResult",
  "description": "The result of a 'markers' job (runner protocol 1.2): MarkerDetectionResult. Corners are [x, y] pairs in ArUco order TL, TR, BR, BL. Points are [x, y] pairs; the runner converts them from MarkerPoint ({X, Y}).",
  "type": "object",
  "required": ["version", "imageWidth", "imageHeight", "markers", "rejected"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "imageWidth": {"type": "integer", "minimum": 1},
    "imageHeight": {"type": "integer", "minimum": 1},
    "markers": {
      "type": "array",
      "items": {"$ref": "#/$defs/marker"},
      "description": "Validated markers, ordered by id; ids are unique."
    },
    "rejected": {
      "type": "array",
      "items": {"$ref": "#/$defs/rejectedMarker"},
      "description": "Decoded candidates that failed validation; empty when none."
    },
    "undecodedCandidateCount": {"type": "integer", "minimum": 0},
    "suspicious": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "marker": {
      "type": "object",
      "required": ["id", "cornersPx", "cornersNormalized", "sidePx", "edgeRatio"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "cornersPx": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "description": "[[x, y] x 4], TL, TR, BR, BL."
        },
        "cornersNormalized": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "description": "The same corners divided by the photo's width / height."
        },
        "sidePx": {"type": "number"},
        "edgeRatio": {"type": "number"},
        "synthetic": {"type": "boolean", "description": "Some corners were reconstructed, not observed."}
      },
      "additionalProperties": true
    },
    "rejectedMarker": {
      "type": "object",
      "required": ["id", "cornersPx", "sidePx", "edgeRatio", "reason"],
      "properties": {
        "id": {"type": "integer"},
        "cornersPx": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "description": "[[x, y] x 4], TL, TR, BR, BL."
        },
        "sidePx": {"type": "number"},
        "edgeRatio": {"type": "number"},
        "reason": {
          "type": "string",
          "enum": ["IdNotAllowed", "TooSmall", "TooOblique", "DuplicateId", "NoQuietZone"],
          "description": "MarkerRejectionReason, as its PascalCase name."
        },
        "detail": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
