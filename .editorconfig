root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,csproj,props,slnx}]
indent_size = 2

[*.cs]
file_header_template = Copyright (c) 2026, zannagh. All rights reserved.\nSee License in the project root for license information.
dotnet_diagnostic.IDE0073.severity = warning
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_namespace_declarations = file_scoped:suggestion

[**/Generated/**.cs]
generated_code = true
